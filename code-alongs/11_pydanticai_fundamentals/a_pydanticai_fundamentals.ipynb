    "from pydantic_ai import Agent\n",
    "\n",
    "# GOOGLE_API_KEY or GEMINI_API_KEY should be defined in .env\n",
    "agent = Agent(model=\"google-gla:gemini-2.5-flash\")\n",
    "\n",
    "result = await agent.run(\"Give me a programming joke\")\n",
    "\n",
    "result\n",
